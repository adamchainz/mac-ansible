// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "alt-shift-l": "editor::GoToDiagnostic",
      "alt-shift-u": "editor::GoToPreviousDiagnostic"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      // Switch tabs by their order, not LRU
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-tab": "pane::ActivateNextItem",
      // Jump around by hunks
      "alt-shift-n": "editor::GoToHunk",
      "alt-shift-e": "editor::GoToPreviousHunk",
      // Copy path, useful for jumping to shell
      "cmd-k cmd-c": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "Editor && mode == full && edit_prediction",
    "bindings": {
      "alt-tab": "editor::AcceptNextWordEditPrediction",
    }
  },
  {
    "bindings": {
      "cmd-k cmd-c cmd-c": "editor::CopyPermalinkToLine"
    }
  },
  {
    "bindings": {
      "cmd-k cmd-r": "editor::ReloadFile"
    }
  },
  {
    "bindings": {
      "cmd-k cmd-shift-f": "text_finder::Toggle"
    }
  }
]
